config {
    type: "table"
}

select
  taxi_id
  ,count(*)                as shifts
  ,countif(shift_hours>= 12)            as long_shifts
  ,safe_divide(countif(shift_hours>= 12),count(*))   as long_shift_share
  ,sum(shift_hours)        as total_hours
  ,avg(shift_hours)        as avg_shift_hours
  ,max(shift_hours)        as max_shift_hours
  ,countif(shift_hours > 24) as implausible_shifts
  ,sum(trips)              as total_trips
from ${ref("int_taxi_shift_model_2")}
group by taxi_id
having count(*) >= 254
   and countif(shift_hours >= 12) / count(*) >= 0.5
order by total_hours desc
limit 100

