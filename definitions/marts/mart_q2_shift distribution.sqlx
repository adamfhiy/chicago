config {
    type: "table"
}

select
  case
    when shift_hours < 4  then '00-04h'
    when shift_hours < 8  then '04-08h'
    when shift_hours < 12 then '08-12h'
    when shift_hours < 16 then '12-16h'
    when shift_hours < 24 then '16-24h'
    else '24h+'
  end                                    as shift_length_bucket
  ,count(*)                              as shifts
  ,count(distinct taxi_id)               as vehicles
  ,round(avg(trips), 1)                  as avg_trips_per_shift
from ${ref("int_taxi_shift_model_2")}
group by shift_length_bucket
order by shift_length_bucket

